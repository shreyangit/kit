{
  "name": "kit-extension",
  "version": "1.0.0",
  "private": true,
  "description": "kit Chrome Extension — 60 instant browser tools",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build --mode production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "node scripts/package.js",
    "verify-sync": "node scripts/verify-registry-sync.js",
    "lint": "eslint popup/src --ext .ts,.tsx"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.7.0",
    "chroma-js": "^2.4.2",
    "qrcode": "^1.5.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/chroma-js": "^2.4.4",
    "@types/chrome": "^0.0.268",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.0",
    "archiver": "^7.0.0",
    "fs-extra": "^11.2.0",
    "jsdom": "^24.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-static-copy": "^3.4.0",
    "vitest": "^1.6.0"
  }
}
